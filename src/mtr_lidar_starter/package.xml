<?xml version="1.0"?>
<package format="3">
  <name>mtr_lidar_starter</name><version>0.1.0</version>
  <description>Hardware-independent LiDAR processing starter for MTR.</description>
  <maintainer email="maintainer@example.com">MTR team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pygame</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>

<?xml version="1.0"?>
<window><width>1100</width><height>750</height></window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre</engine>
  <scene>scene</scene>
  <ambient_light>0.6 0.6 0.6</ambient_light>
  <background_color>0.6 0.75 0.9</background_color>
  <camera_pose>-542 146 22 0 0.8 1.0</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene manager">
  <gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Camera control">
  <gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui>
</plugin>
<plugin filename="ClickToNavigate" name="Boat navigation">
  <gz-gui><property type="string" key="state">docked</property></gz-gui>
</plugin>

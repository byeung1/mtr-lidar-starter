<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Two wall sections leave local y=[-2.75,2.75], a 5.5 m gap. -->
  <model name="demo_wide_gap">
    <static>true</static>
    <link name="left_wall">
      <pose>0 11.375 0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2 17.25 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2 17.25 4</size></box></geometry>
        <material><ambient>0.1 0.5 0.9 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material>
      </visual>
    </link>
    <link name="right_wall">
      <pose>0 -11.375 0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2 17.25 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2 17.25 4</size></box></geometry>
        <material><ambient>0.1 0.5 0.9 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>

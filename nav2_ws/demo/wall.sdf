<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Across the local-map y=[-20,20] test-course width. -->
  <model name="demo_wall">
    <static>true</static>
    <link name="wall">
      <collision name="collision"><geometry><box><size>2 40 4</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2 40 4</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>

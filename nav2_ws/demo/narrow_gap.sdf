<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Two wall sections leave local y=[-1.3,1.3], a 2.6 m gap. -->
  <model name="demo_narrow_gap">
    <static>true</static>
    <link name="left_wall">
      <pose>0 10.65 0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2 18.7 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2 18.7 4</size></box></geometry>
        <material><ambient>0.8 0.1 0.6 1</ambient><diffuse>0.8 0.1 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="right_wall">
      <pose>0 -10.65 0 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2 18.7 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2 18.7 4</size></box></geometry>
        <material><ambient>0.8 0.1 0.6 1</ambient><diffuse>0.8 0.1 0.6 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
